{
  "name": "duty-patrol-economy",
  "group": "duty-economy",
  "blocking": true,
  "timeoutSeconds": 240,
  "observable": "commissioner configures checkpoints, guard starts patrol duty, salary accrues and pays out in real adys_decorations coin items, receipt is idempotent",
  "failure": "patrol never starts, salary not accrued, payout absent, or coin items missing",
  "prerequisites": ["adys_decorations dependency (combined profile)", "testing.enableTestCommands=true"],
  "steps": [
    {"name": "commissioner", "command": "straja test create-player duty_com", "expectNotContains": "disabled"},
    {"name": "pin-commissioner", "command": "straja test set-commissioner duty_com", "expectRegex": "commissioner"},
    {"name": "wand-cp1", "command": "straja test tool-patrol duty_com 0 64 0", "expectNotContains": "disabled"},
    {"name": "wand-cp2", "command": "straja test tool-patrol duty_com 8 64 0", "expectNotContains": "disabled"},
    {"name": "route-finish", "command": "straja test tool-patrol-finish duty_com", "expectNotContains": "disabled"},
    {"name": "route-visible", "command": "straja test tell-log duty_com", "expectRegex": "[Tt]raseu|checkpoint"},
    {"name": "guard", "command": "straja test create-player duty_g1", "expectNotContains": "disabled"},
    {"name": "guard-rank", "command": "straja test set-rank duty_g1 2", "expectContains": "rank="},
    {"name": "start-duty", "command": "straja test start-duty duty_g1", "expectNotContains": "disabled"},
    {"name": "duty-started", "command": "straja test tell-log duty_g1", "expectContains": "Serviciu început"},
    {"name": "assert-on-duty", "command": "straja test assert duty_g1 duty true", "expectContains": "ASSERT PASS"},
    {"name": "grace-window", "command": "straja test policy-set duty_com salary.activityGraceSeconds 100000", "expectNotContains": "disabled"},
    {"name": "active-1", "command": "straja test move duty_g1 1 64 1", "expectNotContains": "disabled"},
    {"name": "accrue-1", "command": "straja test advance-time 3600", "expectContains": "clock advanced"},
    {"name": "active-2", "command": "straja test move duty_g1 2 64 2", "expectNotContains": "disabled"},
    {"name": "accrue-2", "command": "straja test advance-time 3600", "expectContains": "clock advanced"},
    {"name": "salary-accrued", "command": "straja test dump-state duty_g1", "expectRegex": "salary=[1-9]"},
    {"name": "payout", "command": "straja test salary duty_g1", "expectNotContains": "disabled"},
    {"name": "paid-physical", "command": "straja test tell-log duty_g1", "expectContains": "Salariu plătit în monede fizice"},
    {"name": "coins-in-inventory", "command": "straja test inventory duty_g1", "expectContains": "adys_decorations:"},
    {"name": "salary-zeroed", "command": "straja test dump-state duty_g1", "expectRegex": "salary=0"},
    {"name": "payout-idempotent", "command": "straja test salary duty_g1", "expectNotContains": "disabled"},
    {"name": "no-double-pay", "command": "straja test tell-log duty_g1", "expectNotContains": "Salariu plătit în monede fizice.\\n.*Salariu plătit"},
    {"name": "stop-duty", "command": "straja test stop-duty duty_g1", "expectNotContains": "disabled"},
    {"name": "assert-off-duty", "command": "straja test assert duty_g1 duty false", "expectContains": "ASSERT PASS"},
    {"name": "cleanup", "command": "straja test reset-all", "expectContains": "all virtual player state reset", "cleanup": true}
  ]
}
