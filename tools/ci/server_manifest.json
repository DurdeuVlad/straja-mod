  "profiles": {
    "required-only": {
      "description": "Straja + required Envelope runtime only. Coin provider absent by design.",
      "blocking": true,
      "deps": [
        "envelope"
      ],
      "config": {
        "identity.environment": "local",
        "testing.enableTestCommands": true
      },
      "timeoutSeconds": 180
    },
    "coin-provider": {
      "description": "Adds Ady's Decorations so physical coin salary payments resolve.",
      "blocking": true,
      "deps": [
        "envelope",
        "adys_decorations"
      ],
      "config": {
        "identity.environment": "local",
        "testing.enableTestCommands": true
      },
      "timeoutSeconds": 300
    },
    "vampirism": {
      "description": "Adds Vampirism so OptionalModCompatibility routes ownership to the real provider.",
      "blocking": true,
      "deps": [
        "envelope",
        "vampirism"
      ],
      "config": {
        "identity.environment": "local",
        "testing.enableTestCommands": true
      },
      "timeoutSeconds": 300
    },
    "combined": {
      "description": "All declared server-side dependencies together.",
      "blocking": true,
      "deps": [
        "envelope",
        "adys_decorations",
        "vampirism"
      ],
      "config": {
        "identity.environment": "local",
        "testing.enableTestCommands": true
      },
      "timeoutSeconds": 300
    },
    "production-config": {
      "description": "Combined dependencies under a hardened production-like config. Debug/test surfaces must fail closed.",
      "blocking": true,
      "deps": [
        "envelope",
        "adys_decorations",
        "vampirism"
      ],
      "config": {
        "identity.environment": "production",
        "identity.commissionerUuid": "11111111-2222-3333-4444-555555555555",
        "debug.enabled": false,
        "testing.enableTestCommands": false
      },
      "timeoutSeconds": 300
    },
    "foreign-npc": {
      "description": "Advisory: CustomNPCs co-installed. Reported pass/fail/blocked; never blocks.",
      "blocking": false,
      "deps": [
        "envelope",
        "customnpcs"
      ],
      "config": {
        "identity.environment": "local",
        "testing.enableTestCommands": true
      },
      "timeoutSeconds": 300
    },
    "incapacitated": {
      "description": "DC-014 matrix leg: Incapacitated owns generic downed/death; Straja downed must be disabled.",
      "blocking": true,
      "deps": [
        "envelope",
        "incapacitated"
      ],
      "config": {
        "identity.environment": "local",
        "testing.enableTestCommands": true
      },
      "timeoutSeconds": 300
    },
    "piggyback": {
      "description": "DC-014 matrix leg: Piggyback owns the carry interaction; Straja's crouch carry must be disabled.",
      "blocking": true,
      "deps": [
        "envelope",
        "faewulf_lib",
        "piggyback"
      ],
      "config": {
        "identity.environment": "local",
        "testing.enableTestCommands": true
      },
      "timeoutSeconds": 300
    },
    "incapacitated-piggyback": {
      "description": "DC-014 matrix leg: both custody providers co-installed; Straja downed and crouch carry must both be disabled.",
      "blocking": true,
      "deps": [
        "envelope",
        "faewulf_lib",
        "incapacitated",
        "piggyback"
      ],
      "config": {
        "identity.environment": "local",
        "testing.enableTestCommands": true
      },
      "timeoutSeconds": 300
    },
    "full-modpack": {
      "description": "DC-014 matrix leg: full intended pack (Envelope, Ady's Decorations, Vampirism, Incapacitated, Piggyback, CustomNPCs) together.",
      "blocking": true,
      "deps": [
        "envelope",
        "adys_decorations",
        "vampirism",
        "faewulf_lib",
        "incapacitated",
        "piggyback",
