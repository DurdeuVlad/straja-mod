{
  "name": "reconnect-delivery",
  "group": "client-recovery",
  "timeoutSeconds": 420,
  "observable": "a complaint investigated by the real client player is approved while the client is offline, the pending reward is delivered exactly once on the next join (claim transition PENDING -> PAID observed via complaint-dump; the /monede/ chat tell is corroborated at warn level since a dead-ws retry join can consume the claim without an observable session), and a second reconnect produces no duplicate payment",
  "failure": "the pending reward is not delivered on rejoin, is delivered twice, or the complaint chain cannot be driven to CLOSED",
  "prerequisites": ["combined server running", "client joined as ci_straja"],
  "steps": [
    {"name": "complainant", "type": "rcon", "setup": true,
     "command": "straja test create-player cui_s1"},
    {"name": "accused", "type": "rcon", "setup": true,
     "command": "straja test create-player cui_g1"},
    {"name": "commissioner", "type": "rcon", "setup": true,
     "command": "straja test create-player cui_com"},
    {"name": "commissioner-pin", "type": "rcon", "setup": true,
     "command": "straja test set-commissioner cui_com"},
    {"name": "player-position", "type": "mct", "setup": true,
     "args": ["position", "get"],
     "captures": [
       {"name": "px", "regex": "\"x\"\\s*:\\s*(-?[0-9.]+)"},
       {"name": "py", "regex": "\"y\"\\s*:\\s*(-?[0-9.]+)"},
       {"name": "pz", "regex": "\"z\"\\s*:\\s*(-?[0-9.]+)"}]},
    {"name": "com-near-player", "type": "rcon", "setup": true,
     "command": "straja test move cui_com {px} {py} {pz}"},
    {"name": "complainant-near-player", "type": "rcon", "setup": true,
     "command": "straja test move cui_s1 {px} {py} {pz}"},
    {"name": "loc-receptionist", "type": "rcon", "setup": true,
     "command": "straja test set-location cui_com receptionist"},
    {"name": "loc-secretary", "type": "rcon", "setup": true,
     "command": "straja test set-location cui_com secretary"},
    {"name": "investigator-rank", "type": "rcon", "setup": true,
     "command": "straja test set-rank {account} 3"},
    {"name": "file-complaint", "type": "rcon",
     "command": "straja test complaint-submit cui_s1 cui_g1 abuz reclamatie_ci",
     "expectContains": "submit=true"},
    {"name": "complaint-id", "type": "rcon", "setup": true,
     "command": "straja test complaint-dump",
     "capture": {"name": "cid",
                 "regex": "([A-Za-z0-9_-]+) cui_s1 vs"}},
    {"name": "claim", "type": "rcon",
     "command": "straja test complaint-claim {account} {cid}",
     "expectContains": "claim=true"},
    {"name": "report", "type": "rcon",
     "command": "straja test complaint-report {account} {cid} raport_final",
     "expectContains": "report=true"},
    {"name": "complainant-satisfied", "type": "rcon",
     "command": "straja test complaint-decide cui_s1 {cid} satisfied",
     "expectContains": "decide=true"},
    {"name": "client-offline", "type": "client",
     "action": "stop", "setup": true},
    {"name": "resolve-offline", "type": "rcon",
     "command": "straja test complaint-review cui_com {cid} approve",
     "expectContains": "review=true"},
    {"name": "reward-pending", "type": "rcon",
     "command": "straja test complaint-dump",
     "expectRegex": "reward=PENDING"},
    {"name": "client-rejoin", "type": "client",
     "action": "start", "setup": true},
    {"name": "reward-delivered", "type": "rcon",
     "command": "straja test complaint-dump",
     "expectRegex": "reward=PAID"},
    {"name": "reward-tell", "type": "mct", "setup": true,
     "args": ["chat", "history", "--last", "20"],
     "timeout": 30,
     "expect": [{"warnRegex": "monede",
                 "note": "pending-reward tell fires on the join that consumes the claim; a dead-ws retry join delivers the payment without an observable session"}]},
    {"name": "client-rejoin-2", "type": "client",
     "action": "rejoin", "setup": true},
    {"name": "settle", "type": "sleep", "seconds": 10, "setup": true},
    {"name": "no-duplicate-payment", "type": "mct",
     "args": ["chat", "history", "--last", "20"],
     "expectAbsentRegex": "monede pentru investigația"},
    {"name": "claim-paid", "type": "rcon",
     "command": "straja test complaint-dump",
     "expectRegex": "reward=PAID"}
  ],
  "cleanup": [
    {"name": "reset", "type": "rcon",
     "command": "straja test reset-all"}
  ]
}
