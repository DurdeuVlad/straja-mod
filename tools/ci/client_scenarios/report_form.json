{
  "name": "report-form",
  "group": "client-form",
  "timeoutSeconds": 300,
  "observable": "the client (as commissioner) opens the secretary's 4-field multiline report form through a tokenized chat action, an expired session is rejected with 'no longer valid' (stale-session proof), a cancel closes a fresh form without recording, and a resubmitted form records exactly one report visible in the client's status",
  "failure": "the report action token is missing, the form never opens, the stale session is accepted, cancel records a report anyway, or the submit produces no/zero/multiple report records",
  "prerequisites": ["combined server running", "client joined as ci_straja"],
  "steps": [
    {"name": "make-commissioner", "type": "rcon", "setup": true,
     "command": "straja test set-commissioner {account}"},
    {"name": "player-position", "type": "mct", "setup": true,
     "args": ["position", "get"],
     "captures": [
       {"name": "px", "regex": "\"x\"\\s*:\\s*(-?[0-9.]+)"},
       {"name": "py", "regex": "\"y\"\\s*:\\s*(-?[0-9.]+)"},
       {"name": "pz", "regex": "\"z\"\\s*:\\s*(-?[0-9.]+)"}]},
    {"name": "spawn-secretary", "type": "rcon", "setup": true,
     "command": "straja npc spawn secretary {px} {py} {pz}",
     "capture": {"name": "secretary_uuid",
                 "regex": "creat: ([0-9a-f-]{36})"}},
    {"name": "interact-secretary", "type": "mct", "setup": true,
     "args": ["entity", "interact", "--type", "straja:straja_npc",
              "--nearest", "--max-distance", "8"]},
    {"name": "open-report-form", "type": "npc-action",
     "label": "Depune raport de activitate"},
    {"name": "expire-session", "type": "rcon", "setup": true,
     "command": "straja test advance-time 200"},
    {"name": "stale-submit", "type": "form",
     "expectTitleRegex": "(?i)raport|activitate",
     "fill": ["activitate expirata", "misiuni x", "incidente y",
              "note z"],
     "submit": true},
    {"name": "stale-rejected", "type": "mct",
     "args": ["chat", "wait", "--match", "no longer valid",
              "--timeout", "30"],
     "timeout": 60,
     "expect": [{"rawRegex": "no longer valid"}]},
    {"name": "close-stale-form", "type": "mct", "setup": true,
     "args": ["input", "key", "press", "escape"]},
    {"name": "interact-again", "type": "mct", "setup": true,
     "args": ["entity", "interact", "--type", "straja:straja_npc",
              "--nearest", "--max-distance", "8"]},
    {"name": "open-report-2", "type": "npc-action",
     "label": "Depune raport de activitate"},
    {"name": "cancel-form", "type": "form",
     "expectTitleRegex": "(?i)raport|activitate",
     "fill": ["anulat", "anulat", "anulat", "anulat"],
     "cancel": true},
    {"name": "interact-third", "type": "mct", "setup": true,
     "args": ["entity", "interact", "--type", "straja:straja_npc",
              "--nearest", "--max-distance", "8"]},
    {"name": "open-report-3", "type": "npc-action",
     "label": "Depune raport de activitate"},
    {"name": "fill-and-submit", "type": "form",
     "expectTitleRegex": "(?i)raport|activitate",
     "fill": ["Patrula de rutina pe traseul nord",
              "0 misiuni active",
              "Fara incidente",
              "Raport CI automat"],
     "submit": true},
    {"name": "report-deposited", "type": "mct",
     "args": ["chat", "wait", "--match", "a fost depus la Secretariat",
              "--timeout", "30"],
     "timeout": 60,
     "expect": [{"rawRegex": "a fost depus"}]},
    {"name": "exactly-once", "type": "mct",
     "args": ["chat", "history", "--last", "30"],
     "expect": [{"occurrences": "a fost depus la Secretariat",
                 "count": 1}]},
    {"name": "report-screenshot", "type": "screenshot",
     "name": "report-submitted"}
  ],
  "cleanup": [
    {"name": "remove-secretary", "type": "rcon",
     "command": "straja npc remove {secretary_uuid}"},
    {"name": "reset", "type": "rcon",
     "command": "straja test reset-all"}
  ]
}
