{
  "name": "downed-custody",
  "group": "client-custody",
  "timeoutSeconds": 300,
  "requiresClients": 2,
  "observable": "a lethal baton strike puts the real client player into Straja downed state (custody-dump records the UUID), the give-up form auto-opens on the client and can be cancelled via real input, a rope plus head-sack syncs the restrained visual, the custody tick auto-wakes the player past the downed cooldown, the sack can be removed after waking, and a second real client can join while capacity permits",
  "failure": "the strike does not produce a downed record, the give-up form never opens or cannot be cancelled, the rope/sack visual does not sync, the auto-wake tell never arrives, or the second client cannot join",
  "prerequisites": ["combined server running", "client joined as ci_straja", "hosted runner capacity for a second client"],
  "steps": [
    {"name": "guard", "type": "rcon", "setup": true,
     "command": "straja test create-player cui_g1"},
    {"name": "guard-rank", "type": "rcon", "setup": true,
     "command": "straja test set-rank cui_g1 4"},
    {"name": "give-baton", "type": "rcon", "setup": true,
     "command": "straja test give cui_g1 straja:baton 1"},
    {"name": "give-rope", "type": "rcon", "setup": true,
     "command": "straja test give cui_g1 straja:rope 1"},
    {"name": "give-sack", "type": "rcon", "setup": true,
     "command": "straja test give cui_g1 straja:head_sack 1"},
    {"name": "wield-baton", "type": "rcon", "setup": true,
     "command": "straja test select-slot cui_g1 0"},
    {"name": "player-position", "type": "mct", "setup": true,
     "args": ["position", "get"],
     "captures": [
       {"name": "px", "regex": "\"x\"\\s*:\\s*(-?[0-9.]+)"},
       {"name": "py", "regex": "\"y\"\\s*:\\s*(-?[0-9.]+)"},
       {"name": "pz", "regex": "\"z\"\\s*:\\s*(-?[0-9.]+)"}]},
    {"name": "guard-near", "type": "rcon", "setup": true,
     "command": "straja test move cui_g1 {px} {py} {pz}"},
    {"name": "lethal-strike", "type": "rcon",
     "command": "straja test baton-strike cui_g1 {account} 999",
     "expectAbsentRegex": "Unknown player"},
    {"name": "downed-recorded", "type": "rcon",
     "command": "straja test custody-dump",
     "expectRegex": "downed=\\[[0-9a-f-]{36}\\]"},
    {"name": "give-up-form", "type": "form",
     "expectTitleRegex": "(?i)give up",
     "cancel": true},
    {"name": "still-downed", "type": "rcon",
     "command": "straja test custody-dump",
     "expectRegex": "downed=\\[[0-9a-f-]{36}\\]"},
    {"name": "wield-rope", "type": "rcon", "setup": true,
     "command": "straja test select-slot cui_g1 1"},
    {"name": "rope-target", "type": "rcon",
     "command": "straja test rope cui_g1 {account}",
     "expectAbsentRegex": "Unknown player"},
    {"name": "wield-sack", "type": "rcon", "setup": true,
     "command": "straja test select-slot cui_g1 2"},
    {"name": "sack-target", "type": "rcon",
     "command": "straja test head-sack cui_g1 {account}",
     "expectAbsentRegex": "Unknown player"},
    {"name": "sack-synced", "type": "rcon",
     "command": "straja test custody-dump",
     "expectRegex": "sacks=\\[[0-9a-f-]{36}\\]"},
    {"name": "custody-screenshot", "type": "screenshot",
     "name": "downed-restrained-sacked"},
    {"name": "past-wake", "type": "rcon", "setup": true,
     "command": "straja test advance-time 90"},
    {"name": "wake-tick", "type": "sleep", "seconds": 5, "setup": true},
    {"name": "revived", "type": "mct",
     "args": ["chat", "wait", "--match", "Ți-ai revenit", "--timeout", "30"],
     "timeout": 60,
     "expect": [{"rawRegex": "revenit"}]},
    {"name": "sack-remove", "type": "rcon", "setup": true,
     "command": "straja test sack-remove {account}"},
    {"name": "custody-clear", "type": "rcon",
     "command": "straja test custody-dump",
     "expectRegex": "downed=\\[\\].*sacks=\\[\\]|sacks=\\[\\].*downed=\\[\\]"},
    {"name": "second-client-join", "type": "client2",
     "action": "join"},
    {"name": "second-client-health", "type": "client2",
     "action": "mct",
     "args": ["status", "health"],
     "expect": [{"rawRegex": "\"health\"\\s*:"}]},
    {"name": "second-client-stop", "type": "client2",
     "action": "stop"}
  ],
  "cleanup": [
    {"name": "reset", "type": "rcon",
     "command": "straja test reset-all"}
  ]
}
