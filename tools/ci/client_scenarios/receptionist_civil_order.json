{
  "name": "receptionist-civil-order",
  "group": "client-proof",
  "timeoutSeconds": 180,
  "observable": "a civilian interacting with the receptionist opens the native desk GUI; the desk exposes the civilian actions «Depune cererea», «Regulament» and «Am o întrebare»; member bookkeeping (Fișa mea V2 etc.) renders as gated tiles on the same page; the FAQ tile opens a sub-page with « Înapoi, and the back tile returns to the root desk page",
  "failure": "the desk does not open, a civilian action is missing from the desk surface, or the sub-page/back navigation is unreachable",
  "prerequisites": [
    "combined server running",
    "client joined as ci_straja"
  ],
  "steps": [
    {
      "name": "reset-state",
      "type": "rcon",
      "setup": true,
      "command": "straja test reset-all"
    },
    {
      "name": "player-position",
      "type": "mct",
      "setup": true,
      "args": [
        "position",
        "get"
      ],
      "captures": [
        {
          "name": "px",
          "regex": "\"x\"\\s*:\\s*(-?[0-9.]+)"
        },
        {
          "name": "py",
          "regex": "\"y\"\\s*:\\s*(-?[0-9.]+)"
        },
        {
          "name": "pz",
          "regex": "\"z\"\\s*:\\s*(-?[0-9.]+)"
        }
      ]
    },
    {
      "name": "spawn-receptionist",
      "type": "rcon",
      "setup": true,
      "command": "straja npc spawn receptionist {px} {py} {pz}",
      "capture": {
        "name": "receptionist_uuid",
        "regex": "creat: ([0-9a-f-]{36})"
      }
    },
    {
      "name": "interact-receptionist",
      "type": "mct",
      "setup": true,
      "args": [
        "entity",
        "interact",
        "--type",
        "straja:straja_npc",
        "--nearest",
        "--max-distance",
        "8"
      ]
    },
    {
      "name": "surface-settle",
      "type": "sleep",
      "seconds": 2,
      "setup": true
    },
    {
      "name": "desk-opened",
      "type": "mct",
      "args": [
        "gui",
        "wait-open",
        "--timeout",
        "20"
      ],
      "timeout": 30,
      "expect": [
        {
          "rawRegex": "StrajaDeskScreen"
        }
      ]
    },
    {
      "name": "primary-actions-present",
      "type": "rcon",
      "command": "straja test desk-actions {account}",
      "expectRegex": "Depune cererea[\\s\\S]*Regulament|Regulament[\\s\\S]*Depune cererea"
    },
    {
      "name": "faq-action-present",
      "type": "rcon",
      "command": "straja test desk-actions {account}",
      "expectRegex": "Am o întrebare"
    },
    {
      "name": "open-faq",
      "type": "npc-action",
      "label": "Am o întrebare"
    },
    {
      "name": "faq-settle",
      "type": "sleep",
      "seconds": 1,
      "setup": true
    },
    {
      "name": "faq-page-contents",
      "type": "rcon",
      "command": "straja test desk-actions {account}",
      "expectRegex": "Înapoi"
    },
    {
      "name": "back-to-primary",
      "type": "npc-action",
      "label": "Înapoi"
    },
    {
      "name": "back-settle",
      "type": "sleep",
      "seconds": 1,
      "setup": true
    },
    {
      "name": "primary-restored",
      "type": "rcon",
      "command": "straja test desk-actions {account}",
      "expectRegex": "title=Recepție[\\s\\S]*Depune cererea"
    },
    {
      "name": "close-desk",
      "type": "mct",
      "setup": true,
      "args": ["gui", "close"]
    }
  ],
  "cleanup": [
    {
      "name": "close-any-gui",
      "type": "mct",
      "setup": true,
      "args": ["gui", "close"]
    },
    {
      "name": "remove-receptionist",
      "type": "rcon",
      "command": "straja npc remove {receptionist_uuid}"
    },
    {
      "name": "reset",
      "type": "rcon",
      "command": "straja test reset-all"
    }
  ]
}
