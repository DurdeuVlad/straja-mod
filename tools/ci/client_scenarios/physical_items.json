{
  "name": "physical-items",
  "group": "client-items",
  "timeoutSeconds": 240,
  "observable": "the training_manual physical item reaches the real client hotbar, right-click use fires the physical-item surface on the server, and the rules text is rendered in client chat; the fine_book surfaces its capability gate message for a civilian holder",
  "failure": "the manual never reaches the held slot, use produces no rules message, or the fine_book capability gate does not respond",
  "prerequisites": ["combined server running", "client joined as ci_straja"],
  "steps": [
    {"name": "give-manual", "type": "rcon", "setup": true,
     "command": "straja test give {account} straja:training_manual 1"},
    {"name": "give-fine-book", "type": "rcon", "setup": true,
     "command": "straja test give {account} straja:fine_book 1"},
    {"name": "select-manual", "type": "mct", "setup": true,
     "args": ["inventory", "hotbar", "0"]},
    {"name": "manual-held", "type": "mct",
     "args": ["inventory", "held",
              "--type", "straja:training_manual", "--wait", "20"],
     "timeout": 40,
     "expect": [{"rawRegex": "training_manual"}]},
    {"name": "use-manual", "type": "mct", "setup": true,
     "args": ["inventory", "use"]},
    {"name": "rules-rendered", "type": "mct",
     "args": ["chat", "wait", "--match", "Ranguri:", "--timeout", "30"],
     "timeout": 60,
     "expect": [{"rawRegex": "Ranguri:"}]},
    {"name": "rules-screenshot", "type": "screenshot",
     "name": "training-manual-rules"},
    {"name": "select-fine-book", "type": "mct", "setup": true,
     "args": ["inventory", "hotbar", "1"]},
    {"name": "book-held", "type": "mct",
     "args": ["inventory", "held",
              "--type", "straja:fine_book", "--wait", "20"],
     "timeout": 40,
     "expect": [{"rawRegex": "fine_book"}]},
    {"name": "use-fine-book", "type": "mct", "setup": true,
     "args": ["inventory", "use"]},
    {"name": "gate-message", "type": "mct",
     "args": ["chat", "wait", "--match",
              "rezervat Străjii active", "--timeout", "30"],
     "timeout": 60,
     "expect": [{"rawRegex": "rezervat"}]}
  ],
  "cleanup": [
    {"name": "reset", "type": "rcon",
     "command": "straja test reset-all"}
  ]
}
