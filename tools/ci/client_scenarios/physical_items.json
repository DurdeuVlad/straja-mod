{
  "name": "physical-items",
  "group": "client-items",
  "timeoutSeconds": 240,
  "observable": "the training_manual physical item reaches the real client hotbar, right-click use succeeds, and book.read exposes the manual title and rules pages (the manual is a WrittenBookItem — its rules render as book pages; mct's gui surface only tracks HandledScreen containers, so the book screen is verified via content, not gui state); the fine_book surfaces its capability gate message in chat for a civilian holder",
  "failure": "the manual never reaches the held slot, use fails, book.read cannot read the manual title/pages, or the fine_book capability gate does not respond",
  "prerequisites": ["combined server running", "client joined as ci_straja"],
  "steps": [
    {"name": "give-manual", "type": "rcon", "setup": true,
     "command": "straja test give {account} straja:training_manual 1"},
    {"name": "give-fine-book", "type": "rcon", "setup": true,
     "command": "straja test give {account} straja:fine_book 1"},
    {"name": "select-manual", "type": "mct", "setup": true,
     "args": ["inventory", "hotbar", "0"]},
    {"name": "manual-held", "type": "mct",
     "args": ["inventory", "held",
              "--type", "straja:training_manual", "--wait", "20"],
     "timeout": 40,
     "expect": [{"rawRegex": "training_manual"}]},
    {"name": "use-manual", "type": "mct", "setup": true,
     "args": ["inventory", "use"]},
    {"name": "manual-settle", "type": "sleep", "seconds": 2,
     "setup": true},
    {"name": "manual-readable", "type": "mct",
     "args": ["book", "read"],
     "timeout": 30,
     "expect": [{"rawRegex": "Manualul Str|Jur.m.ntul"}]},
    {"name": "rules-screenshot", "type": "screenshot",
     "name": "training-manual-rules"},
    {"name": "book-close", "type": "mct", "setup": true,
     "args": ["input", "key", "press", "escape"]},
    {"name": "select-fine-book", "type": "mct", "setup": true,
     "args": ["inventory", "hotbar", "1"]},
    {"name": "book-held", "type": "mct",
     "args": ["inventory", "held",
              "--type", "straja:fine_book", "--wait", "20"],
     "timeout": 40,
     "expect": [{"rawRegex": "fine_book"}]},
    {"name": "use-fine-book", "type": "mct", "setup": true,
     "args": ["inventory", "use"]},
    {"name": "book-settle", "type": "sleep", "seconds": 2,
     "setup": true},
    {"name": "gate-message", "type": "mct",
     "args": ["chat", "history", "--last", "20"],
     "timeout": 30,
     "expect": [{"rawRegex": "rezervat"}]}
  ],
  "cleanup": [
    {"name": "reset", "type": "rcon",
     "command": "straja test reset-all"}
  ]
}
