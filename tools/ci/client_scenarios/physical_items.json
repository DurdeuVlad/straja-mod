{
  "name": "physical-items",
  "group": "client-items",
  "timeoutSeconds": 240,
  "observable": "the training_manual physical item reaches the real client hotbar, right-click use succeeds, and the vanilla written-book screen opens (gui wait-open reports BookViewScreen; book.read is unusable here because it only accepts the exact vanilla WRITTEN_BOOK item, not custom subclasses); a screenshot captures the rendered manual rules; the fine_book surfaces its capability gate message in chat for a civilian holder",
  "failure": "the manual never reaches the held slot, use fails, the written-book screen never opens, or the fine_book capability gate does not respond",
  "prerequisites": ["combined server running", "client joined as ci_straja"],
  "steps": [
    {"name": "give-manual", "type": "rcon", "setup": true,
     "command": "straja test give {account} straja:training_manual 1"},
    {"name": "give-fine-book", "type": "rcon", "setup": true,
     "command": "straja test give {account} straja:fine_book 1"},
    {"name": "select-manual", "type": "mct", "setup": true,
     "args": ["inventory", "hotbar", "0"]},
    {"name": "manual-held", "type": "mct",
     "args": ["inventory", "held",
              "--type", "straja:training_manual", "--wait", "20"],
     "timeout": 40,
     "expect": [{"rawRegex": "training_manual"}]},
    {"name": "use-manual", "type": "mct", "setup": true,
     "args": ["inventory", "use"]},
    {"name": "manual-settle", "type": "sleep", "seconds": 2,
     "setup": true},
    {"name": "manual-readable", "type": "mct",
     "args": ["gui", "wait-open", "--timeout", "20"],
     "timeout": 30,
     "expect": [{"rawRegex": "BookViewScreen"}]},
    {"name": "training-manual-rules", "type": "screenshot"},
    {"name": "book-close", "type": "mct", "setup": true,
     "args": ["input", "key", "press", "escape"]},
    {"name": "select-fine-book", "type": "mct", "setup": true,
     "args": ["inventory", "hotbar", "1"]},
    {"name": "book-held", "type": "mct",
     "args": ["inventory", "held",
              "--type", "straja:fine_book", "--wait", "20"],
     "timeout": 40,
     "expect": [{"rawRegex": "fine_book"}]},
    {"name": "use-fine-book", "type": "mct", "setup": true,
     "args": ["inventory", "use"]},
    {"name": "book-settle", "type": "sleep", "seconds": 2,
     "setup": true},
    {"name": "gate-message", "type": "mct",
     "args": ["chat", "history", "--last", "20"],
     "timeout": 30,
     "expect": [{"rawRegex": "reserved"}]}
  ],
  "cleanup": [
    {"name": "reset", "type": "rcon",
     "command": "straja test reset-all"}
  ]
}
