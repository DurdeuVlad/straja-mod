{
  "name": "customnpcs-admin-provisioning",
  "group": "client-customnpcs",
  "timeoutSeconds": 600,
  "observable": "an operator uses the Straja NPC Wand on a real CustomNPCs entity, the native CustomNPCs GUI lists preconfigured Straja profiles, a profile selection publishes its player-facing dialog surface, the profile can be replaced in-game, the assignment survives reconnect, explicit unassignment removes the Straja surface, and the host retains only native CustomNPCs behavior across a client rejoin",
  "failure": "the admin-only left-click selector does not open, a disabled/non-admin path exposes the selector, profile selection does not publish a native GuiCustom surface, replacement does not take effect, the assignment is lost after reconnect, unassignment leaves a Straja surface bound, or the host does not return to native CustomNPCs behavior after unassign",
  "prerequisites": [
    "foreign-npc server profile running",
    "client joined as ci_straja",
    "CustomNPCs 1.21.1.20251230 present on server and client",
    "Straja NPC Wand is registered"
  ],
  "steps": [
    {
      "name": "grant-operator-and-wand",
      "type": "rcon",
      "setup": true,
      "command": "op ci_straja"
    },
    {
      "name": "give-npc-wand",
      "type": "rcon",
      "setup": true,
      "command": "give ci_straja straja:npc_wand 1"
    },
    {
      "name": "select-npc-wand",
      "type": "mct",
      "setup": true,
      "args": ["inventory", "hotbar", "0"]
    },
    {
      "name": "npc-wand-is-held",
      "type": "mct",
      "args": ["inventory", "held", "--type", "straja:npc_wand", "--wait", "20"],
      "timeout": 40,
      "expect": [{"rawRegex": "npc_wand"}]
    },
    {
      "name": "spawn-unconfigured-customnpc",
      "type": "rcon",
      "setup": true,
      "command": "execute as ci_straja at @s run noppes npc \"Straja Provisioning Target\" create"
    },
    {
      "name": "capture-customnpc",
      "type": "mct",
      "args": ["entity", "list", "--radius", "12"],
      "expect": [{"rawRegex": "customnpcs:customnpc"}],
      "capture": {
        "name": "target_uuid",
        "regex": "\\\"uuid\\\"\\s*:\\s*\\\"([0-9a-f-]{36})\\\"[^}]*\\\"type\\\"\\s*:\\s*\\\"customnpcs:customnpc\\\""
      }
    },
    {
      "name": "left-click-with-admin-wand",
      "type": "mct",
      "args": ["entity", "attack", "--type", "customnpcs:customnpc", "--nearest", "--max-distance", "8"],
      "expect": [{"rawRegex": "customnpcs:customnpc"}]
    },
    {
      "name": "admin-selector-opens",
      "type": "mct",
      "args": ["gui", "wait-open", "--timeout", "20"],
      "expect": [{"rawRegex": "\\\"open\\\"\\s*:\\s*true"}]
    },
    {
      "name": "admin-selector-is-native-custom-gui",
      "type": "mct",
      "args": ["gui", "info"],
      "expect": [{"rawRegex": "\\\"type\\\"\\s*:\\s*\\\"GuiCustom\\\""}]
    },
    {
      "name": "admin-selector-layout",
      "type": "mct",
      "args": ["gui", "layout"],
      "expect": [{"rawRegex": "\\\"scaledWidth\\\"\\s*:\\s*427"}]
    },
    {
      "name": "admin-selector-screenshot",
      "type": "screenshot"
    },
    {
      "name": "choose-jailer-profile",
      "type": "mct",
      "args": ["input", "click", "108", "119"],
      "expect": [{"rawRegex": "\\\"clicked\\\"\\s*:\\s*true"}]
    },
    {
      "name": "wait-for-jailer-confirm",
      "type": "sleep",
      "seconds": 1
    },
    {
      "name": "confirm-jailer-profile",
      "type": "mct",
      "args": ["input", "click", "107", "161"],
      "expect": [{"rawRegex": "\\\"clicked\\\"\\s*:\\s*true"}]
    },
    {
      "name": "wait-for-selector-return",
      "type": "sleep",
      "seconds": 1
    },
    {
      "name": "jailer-binding-persisted",
      "type": "rcon",
      "command": "straja npc provider status",
      "expectContains": "mode=",
      "expectRegex": "profile=straja\\.jailer\\.custody \\| host="
    },
    {
      "name": "close-admin-selector",
      "type": "mct",
      "setup": true,
      "args": ["gui", "close"]
    },
    {
      "name": "remove-admin-capability",
      "type": "rcon",
      "setup": true,
      "command": "deop ci_straja"
    },
    {
      "name": "player-surface-opens-after-assignment",
      "type": "mct",
      "args": ["entity", "interact", "--type", "customnpcs:customnpc", "--nearest", "--max-distance", "8"],
      "expect": [{"rawRegex": "customnpcs:customnpc"}]
    },
    {
      "name": "player-surface-is-native-custom-gui",
      "type": "mct",
      "args": ["gui", "wait-open", "--timeout", "20"],
      "expect": [{"rawRegex": "\\\"open\\\"\\s*:\\s*true"}]
    },
    {
      "name": "player-surface-action-dispatches",
      "type": "mct",
      "args": ["input", "click", "108", "91"],
      "expect": [{"rawRegex": "\\\"clicked\\\"\\s*:\\s*true"}]
    },
    {
      "name": "jailer-action-reaches-canonical-service",
      "type": "mct",
      "args": ["chat", "history", "--last", "20", "--match", "Nu ești încătușat.", "--wait", "10"],
      "timeout": 60,
      "expect": [{"rawRegex": "Nu ești încătușat"}]
    },
    {
      "name": "close-player-surface",
      "type": "mct",
      "setup": true,
      "args": ["gui", "close"]
    },
    {
      "name": "regrant-admin-capability",
      "type": "rcon",
      "setup": true,
      "command": "op ci_straja"
    },
    {
      "name": "reopen-admin-selector",
      "type": "mct",
      "args": ["entity", "attack", "--type", "customnpcs:customnpc", "--nearest", "--max-distance", "8"],
      "expect": [{"rawRegex": "customnpcs:customnpc"}]
    },
    {
      "name": "selector-reopens-for-replacement",
      "type": "mct",
      "args": ["gui", "wait-open", "--timeout", "20"],
      "expect": [{"rawRegex": "\\\"open\\\"\\s*:\\s*true"}]
    },
    {
      "name": "choose-secretary-profile",
      "type": "mct",
      "args": ["input", "click", "108", "169"],
      "expect": [{"rawRegex": "\\\"clicked\\\"\\s*:\\s*true"}]
    },
    {
      "name": "wait-for-secretary-confirm",
      "type": "sleep",
      "seconds": 1
    },
    {
      "name": "confirm-secretary-profile",
      "type": "mct",
      "args": ["input", "click", "107", "161"],
      "expect": [{"rawRegex": "\\\"clicked\\\"\\s*:\\s*true"}]
    },
    {
      "name": "wait-for-selector-return-secretary",
      "type": "sleep",
      "seconds": 1
    },
    {
      "name": "secretary-binding-persisted",
      "type": "rcon",
      "command": "straja npc provider status",
      "expectContains": "mode=",
      "expectRegex": "profile=straja\\.secretary\\.workflows \\| host="
    },
    {
      "name": "replacement-surface-visible",
      "type": "mct",
      "args": ["gui", "info"],
      "expect": [{"rawRegex": "\\\"open\\\"\\s*:\\s*true"}]
    },
    {
      "name": "close-replacement-surface",
      "type": "mct",
      "setup": true,
      "args": ["gui", "close"]
    },
    {
      "name": "reconnect-for-persistence-check",
      "type": "client",
      "action": "reconnect"
    },
    {
      "name": "remove-wand-before-normal-player-check",
      "type": "rcon",
      "setup": true,
      "command": "clear ci_straja straja:npc_wand"
    },
    {
      "name": "deop-before-persistence-check",
      "type": "rcon",
      "setup": true,
      "command": "deop ci_straja"
    },
    {
      "name": "reconnect-player-surface-after-reload",
      "type": "mct",
      "args": ["entity", "interact", "--type", "customnpcs:customnpc", "--nearest", "--max-distance", "8"],
      "expect": [{"rawRegex": "customnpcs:customnpc"}]
    },
    {
      "name": "persisted-surface-reopens",
      "type": "mct",
      "args": ["gui", "wait-open", "--timeout", "20"],
      "expect": [{"rawRegex": "\\\"open\\\"\\s*:\\s*true"}]
    },
    {
      "name": "persisted-surface-screenshot",
      "type": "screenshot"
    },
    {
      "name": "close-persisted-surface",
      "type": "mct",
      "setup": true,
      "args": ["gui", "close"]
    },
    {
      "name": "regrant-admin-for-unassign",
      "type": "rcon",
      "setup": true,
      "command": "op ci_straja"
    },
    {
      "name": "regive-npc-wand",
      "type": "rcon",
      "setup": true,
      "command": "give ci_straja straja:npc_wand 1"
    },
    {
      "name": "reselect-npc-wand",
      "type": "mct",
      "setup": true,
      "args": ["inventory", "hotbar", "0"]
    },
    {
      "name": "npc-wand-held-for-unassign",
      "type": "mct",
      "args": ["inventory", "held", "--type", "straja:npc_wand", "--wait", "20"],
      "timeout": 40,
      "expect": [{"rawRegex": "npc_wand"}]
    },
    {
      "name": "reopen-selector-for-unassign",
      "type": "mct",
      "args": ["entity", "attack", "--type", "customnpcs:customnpc", "--nearest", "--max-distance", "8"],
      "expect": [{"rawRegex": "customnpcs:customnpc"}]
    },
    {
      "name": "selector-open-for-unassign",
      "type": "mct",
      "args": ["gui", "wait-open", "--timeout", "20"],
      "expect": [{"rawRegex": "\\\"open\\\"\\s*:\\s*true"}]
    },
    {
      "name": "click-unassign",
      "type": "mct",
      "args": ["input", "click", "342", "225"],
      "expect": [{"rawRegex": "\\\"clicked\\\"\\s*:\\s*true"}]
    },
    {
      "name": "wait-for-unassign-dialog",
      "type": "sleep",
      "seconds": 1
    },
    {
      "name": "unassign-confirmation-opens",
      "type": "mct",
      "args": ["gui", "wait-open", "--timeout", "20"],
      "expect": [{"rawRegex": "\\\"open\\\"\\s*:\\s*true"}]
    },
    {
      "name": "confirm-unassign",
      "type": "mct",
      "args": ["input", "click", "107", "161"],
      "expect": [{"rawRegex": "\\\"clicked\\\"\\s*:\\s*true"}]
    },
    {
      "name": "wait-for-selector-after-unassign",
      "type": "sleep",
      "seconds": 1
    },
    {
      "name": "post-unassign-selector",
      "type": "screenshot"
    },
    {
      "name": "close-post-unassign-gui",
      "type": "mct",
      "setup": true,
      "args": ["gui", "close"]
    },
    {
      "name": "deop-after-unassign",
      "type": "rcon",
      "setup": true,
      "command": "deop ci_straja"
    },
    {
      "name": "clear-wand-after-unassign",
      "type": "rcon",
      "setup": true,
      "command": "clear ci_straja straja:npc_wand"
    },
    {
      "name": "interact-after-unassign",
      "type": "mct",
      "args": ["entity", "interact", "--type", "customnpcs:customnpc", "--nearest", "--max-distance", "8"],
      "expect": [{"rawRegex": "customnpcs:customnpc"}]
    },
    {
      "name": "native-host-behavior-after-unassign",
      "type": "mct",
      "args": ["gui", "info"],
      "timeout": 30,
      "expectAbsentRegex": "\\\"type\\\"\\s*:\\s*\\\"GuiCustom\\\""
    },
    {
      "name": "provider-status-after-unassign",
      "type": "rcon",
      "command": "straja npc provider status",
      "expectContains": "mode=",
      "expectAbsentRegex": "host="
    },
    {
      "name": "unassigned-state-screenshot",
      "type": "screenshot"
    },
    {
      "name": "rejoin-after-unassign",
      "type": "client",
      "action": "rejoin"
    },
    {
      "name": "interact-after-rejoin-unassigned",
      "type": "mct",
      "args": ["entity", "interact", "--type", "customnpcs:customnpc", "--nearest", "--max-distance", "8"],
      "expect": [{"rawRegex": "customnpcs:customnpc"}]
    },
    {
      "name": "native-behavior-persists-after-rejoin",
      "type": "mct",
      "args": ["gui", "info"],
      "timeout": 30,
      "expectAbsentRegex": "\\\"type\\\"\\s*:\\s*\\\"GuiCustom\\\""
    }
  ],
  "cleanup": [
    {
      "name": "close-gui-cleanup",
      "type": "mct",
      "args": ["gui", "close"],
      "setup": true
    },
    {
      "name": "clear-wand-cleanup",
      "type": "rcon",
      "command": "clear ci_straja straja:npc_wand",
      "setup": true
    },
    {
      "name": "remove-customnpc",
      "type": "rcon",
      "command": "noppes npc \"Straja Provisioning Target\" delete",
      "setup": true
    },
    {
      "name": "deop-client-cleanup",
      "type": "rcon",
      "command": "deop ci_straja",
      "setup": true
    }
  ]
}
